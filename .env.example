# Development can remain in mock mode. Set to false after configuring the backend.
NEXT_PUBLIC_USE_MOCK=true
# Set when using the backend so the dashboard's status controls use the API:
# NEXT_PUBLIC_LEAD_STATUS_URL=/api/leads/{id}

# Server-only secrets. Never use NEXT_PUBLIC_ for these.
DNOTIFIER_APP_ID=
DNOTIFIER_SECRET=
SUPABASE_URL=
SUPABASE_KEY=
